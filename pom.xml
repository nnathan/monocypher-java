<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>net.lastninja.monocypher</groupId>
    <artifactId>monocypher-java</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>monocypher-java</name>
    <description>monocypher-java provides effortless bindings to the Monocypher cryptography library</description>
    <url>https://github.com/nnathan/monocypher-java</url>

    <developers>
        <developer>
          <name>Naveen Nathan</name>
          <email>naveen@lastninja.net</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/nnathan/monocypher-java.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/nnathan/monocypher-java.git</developerConnection>
        <url>https://github.com/nnathan/monocypher-java</url>
    </scm>

    <licenses>
        <license>
          <name>CC0-1.0</name>
          <url>https://creativecommons.org/publicdomain/zero/1.0/legalcode</url>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>8</maven.compiler.release>
        <argLine>-Xcheck:jni</argLine>
    </properties>

    <dependencies>
        <dependency>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter</artifactId>
          <version>5.10.2</version> <!-- or latest -->
          <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
              <directory>build/native</directory>
              <targetPath>native</targetPath>
              <excludes>
                <exclude>android-*/**</exclude>
              </excludes>
            </resource>
            <resource>
              <directory>${project.basedir}</directory>
              <targetPath>META-INF</targetPath>
              <includes>
                <include>LICENSE</include>
              </includes>
            </resource>
            <resource>
              <directory>vendor/monocypher</directory>
              <targetPath>META-INF/monocypher</targetPath>
              <includes>
                <include>LICENCE.md</include>
              </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-jar-plugin</artifactId>
              <version>3.4.2</version>
              <configuration>
                <archive>
                  <manifestEntries>
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                  </manifestEntries>
                </archive>
              </configuration>
            </plugin>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <version>3.2.5</version>
              <configuration>
                <useFile>false</useFile>
                <printSummary>true</printSummary>
                <reportFormat>brief</reportFormat>
                <properties>
                  <property>
                    <name>listener</name>
                    <value>VerboseTestListener</value>
                  </property>
                </properties>
              </configuration>
            </plugin>
            <!-- Maven Central requires a sources jar and a Javadoc jar. Both are built every time. -->
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-source-plugin</artifactId>
              <version>3.3.1</version>
              <configuration>
                <excludes>
                  <exclude>**/*.so</exclude>
                  <exclude>**/*.dylib</exclude>
                  <exclude>**/*.dll</exclude>
                </excludes>
              </configuration>
              <executions>
                <execution>
                  <id>attach-sources</id>
                  <goals>
                    <goal>jar-no-fork</goal>
                  </goals>
                </execution>
              </executions>
            </plugin>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-javadoc-plugin</artifactId>
              <version>3.11.2</version>
              <configuration>
                <source>8</source>
                <doclint>none</doclint>
                <quiet>true</quiet>
                <windowtitle>monocypher-java</windowtitle>
                <doctitle>monocypher-java</doctitle>
                <additionalOptions>
                  <additionalOption>-noqualifier</additionalOption>
                  <additionalOption>all</additionalOption>
                </additionalOptions>
              </configuration>
              <executions>
                <execution>
                  <id>attach-javadocs</id>
                  <goals>
                    <goal>jar</goal>
                  </goals>
                </execution>
              </executions>
            </plugin>
        </plugins>
    </build>
</project>
